+function putFormula(fixture, address, result) {
+    const cell = fixture.cell(address);
+    cell.value = result;
+    cell.formula = '="' + result + '"';
+    return cell;
+}
+
+function generatedNote(text) {
+    return 'ROLL_PLANNING_GENERATED|' + JSON.stringify({ previousValue: '旧案', generatedValue: text });
+}
+
+for (const address of ['D5', 'N1', 'K5', 'H5']) {
+    test('formula survives with zero writes when refresh would replace ' + address, () => {
+        const fixture = existingDraftFixture();
+        const cell = putFormula(fixture, address, address === 'D5' ? 'D13' : '匿名');
+        if (address === 'K5') cell.note = generatedNote('匿名');
+        if (address === 'H5') fixture.plan.suggestions.push({ date: '2032-01-01', column: 'H', text: '作業候補' });
+        const before = { ...cell };
+        assert.throws(fixture.reExport, /手修正の数式/);
+        assert.deepEqual(fixture.writes, []);
+        assert.deepEqual(cell, before);
+    });
+}
+

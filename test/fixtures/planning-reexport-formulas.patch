+function putFormula(fixture, address, result) {
+    const cell = fixture.cell(address);
+    cell.value = result;
+    cell.formula = '="' + result + '"';
+    return cell;
+}
+
+function generatedNote(text) {
+    return 'ROLL_PLANNING_GENERATED|' + JSON.stringify({ previousValue: '旧案', generatedValue: text });
+}
+
+for (const address of ['D5', 'N1', 'K5', 'H5']) {
+    test('formula survives with zero writes when refresh would replace ' + address, () => {
+        const fixture = existingDraftFixture();
+        const cell = putFormula(fixture, address, address === 'D5' ? 'D13' : '匿名');
+        if (address === 'K5') cell.note = generatedNote('匿名');
+        if (address === 'H5') fixture.plan.suggestions.push({ date: '2032-01-01', column: 'H', text: '作業候補' });
+        const before = { ...cell };
+        assert.throws(fixture.reExport, /手修正の数式/);
+        assert.deepEqual(fixture.writes, []);
+        assert.deepEqual(cell, before);
+    });
+}
+
+test('untouched work, carry-forward and other formulas allow a normal refresh', () => {
+    const fixture = existingDraftFixture();
+    const addresses = ['K5', 'K38', 'P50'];
+    for (const addr of addresses) putFormula(fixture, addr, '匿名');
+    assert.equal(fixture.reExport().state, 'complete');
+    for (const addr of addresses) assert.equal(fixture.cell(addr).formula, '="匿名"');
+});
+
+test('a different display result from the generated value keeps the user formula', () => {
+    const fixture = existingDraftFixture();
+    const cell = putFormula(fixture, 'K5', '手入力');
+    cell.note = generatedNote('自動案');
+    assert.equal(fixture.reExport().state, 'complete');
+    assert.equal(cell.formula, '="手入力"');
+});
+
+test('duplicate size change leaves the target formula intact without blocking refresh', () => {
+    const fixture = existingDraftFixture();
+    const cell = putFormula(fixture, 'H5', '匿名');
+    fixture.cell('K5').value = 'サイズ替';
+    fixture.plan.suggestions.push({ date: '2032-01-01', column: 'H', text: 'サイズ替' });
+    assert.equal(fixture.reExport().state, 'complete');
+    assert.equal(cell.formula, '="匿名"');
